{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/weekly_digest.py:*)",
      "Bash(python3 scripts/label_pr.py:*)",
      "Bash(python3 scripts/bump_changelog.py:*)",
      "Bash(make check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Read(.env*)",
      "Read(**/.env*)"
    ]
  },
  "env": {
    "DEVPULSE_DATA_DIR": ".devpulse",
    "DEVPULSE_DEFAULT_DAYS": "7"
  },
  "includeCoAuthoredBy": false
}
