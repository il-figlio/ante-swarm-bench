  "channels": ["temp", "hum", "press"]
 },
 "commands": {
  "PING": ["PONG"],
  "READ": ["DATA"],
  "STREAM": ["SAMPLE", "END"],
  "CHANNELS": ["CHAN"],
  "CALIBRATE": ["OK"]
 },
 "reads": {
  "temp": [21.50, 22.00, 21.00, 23.50, 22.30, 21.80],
  "hum": [44.00, 44.50, 43.80, 44.10],
  "press": [101.30, 101.31, 101.28]
 },
 "stream": [
  ["temp", 21.50],
  ["hum", 44.00],
  ["press", 101.30],
  ["temp", 21.72],
  ["hum", 44.12],
  ["press", 101.33],
  ["temp", 21.90],
  ["hum", 44.31]
 ],
 "scenarios": {
  "clean": {},
  "corrupt": {
   "inject": [
    {"after_seq": 1, "kind": "garbage", "hex": "DEADBEEF"},
    {"after_seq": 3, "kind": "bad_checksum",
     "payload": "SAMPLE 97 temp 00.00"}
