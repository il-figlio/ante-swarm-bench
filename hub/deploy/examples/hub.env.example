# Swarm hub environment (names and placeholder values only; the real file is mode 600 and never in git).
SWARM_ALLOWED_EMAILS=owner@example.com
SWARM_INGRESS_TOKEN=<random 32+ bytes, same value as the nginx X-Swarm-Ingress include>
# Optional
# SWARM_HUB_PORT=8003
# SWARM_RUNS_DIR=/var/lib/swarm-hub/runs
# SWARM_STATIC_DIR=/opt/swarm-hub/hub/static
# SWARM_ANNOTATIONS_DIR=/var/lib/swarm-hub/annotations
# SWARM_LOGIN_URL=/__exe.dev/login?redirect=%2Fswarm%2F
# SWARM_RUNNER=/opt/swarm-hub/runner/swarm_run.py
# SWARM_PACKS_DIR=/opt/swarm-hub/bench/tasks
# SWARM_MAX_VMS=2
# SWARM_MAX_LOCAL=32
# SWARM_USD_PER_MTOK_IN=
# SWARM_USD_PER_MTOK_CACHED=
# SWARM_USD_PER_MTOK_OUT=
# SWARM_PRICE_SOURCE=
# Runner (inherited by the child process)
# SWARM_GOLDEN=ante-golden
# SWARM_CELL_PREFIX=bench-c
# SWARM_CELL_DOMAIN=exe.xyz
# HOME=/var/lib/swarm-hub
